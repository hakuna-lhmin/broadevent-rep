# ─────────────────────────────────────────────────────────
# BroadEvent AutoAlert — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── AI Provider ───────────────────────────────────────────
# Options: "codex" | "claude" | "worker"
# "codex"  = OpenAI GPT-4o (default, recommended for production with web search)
# "claude" = Anthropic Claude (direct — dev only)
# "worker" = Cloudflare Worker proxy (production; hides all API keys from client)
VITE_AI_PROVIDER=codex

# Override the model used by the chosen provider (optional)
# Codex examples:  gpt-4o  |  gpt-4o-mini  |  o3
# Claude examples: claude-sonnet-4-20250514  |  claude-haiku-4-5-20251001
VITE_AI_MODEL=gpt-4o

# ── API Keys (local dev only — use Worker proxy in production) ──
VITE_OPENAI_API_KEY=sk-...your_openai_key
VITE_CLAUDE_API_KEY=sk-ant-...your_claude_key   # only needed if VITE_AI_PROVIDER=claude

# ── Cloudflare Worker URL (set in production; leave blank for local dev) ──
VITE_WORKER_URL=https://broadevent-worker.your-subdomain.workers.dev
